{
	"name": "Jekyll Site",
	"image": "mcr.microsoft.com/devcontainers/ruby:3.2-bookworm",

	// Since I'm using Podman, 'root' inside maps to 'local user' outside.
	// This gives you perfect permissions without chown hacks (which make a big mess).
	"remoteUser": "root",

	// Node is needed to pre-render Mermaid diagrams to SVG (scripts/pre-render-mermaid.js).
	"features": {
		"ghcr.io/devcontainers/features/node:1": {
			"version": "22"
		}
	},

	"containerEnv": {
		// Puppeteer publishes no Chromium build for linux/arm64, so skip its
		// download and use the Chromium that post-create.sh installs from apt.
		"PUPPETEER_SKIP_DOWNLOAD": "true",
		"PUPPETEER_EXECUTABLE_PATH": "/usr/bin/chromium"
	},

	// Keep node_modules out of the bind mount so the container's Linux install
	// and the host's macOS install cannot overwrite each other.
	"mounts": [
		"source=website-node-modules,target=${containerWorkspaceFolder}/node_modules,type=volume"
	],

	"customizations": {
		"vscode": {
			"extensions": [
				"streetsidesoftware.code-spell-checker",
				"Shopify.ruby-lsp"
			]
		}
	},

	// The site goes through VS Code's port forwarding, which is what makes the
	// auto-opened browser tab use http://localhost:3000.
	"forwardPorts": [3000],
	// LiveReload is published straight from Podman instead. VS Code's forwarder
	// keeps accepting connections while Jekyll is down or restarting, and Jekyll
	// loads livereload.js with a blocking document.write, so a stalled livereload
	// connection froze the whole page.
	"appPort": [35729],
	"portsAttributes": {
		"3000": { "label": "Jekyll" },
		"35729": { "label": "LiveReload", "onAutoForward": "ignore" }
	},

	// Run the setup script (configures git, installs bundle)
	"postCreateCommand": "sh .devcontainer/post-create.sh"
}